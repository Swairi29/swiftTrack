# Copy this file to .env before running the project. Do not commit .env.
# Replace every demo value before any non-local deployment.
JWT_SECRET_KEY=change-this-to-a-long-random-value
ALLOWED_ORIGINS=http://localhost:8090,http://localhost:8081,null,http://localhost:5500,http://127.0.0.1:5500

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=swifttrack
POSTGRES_USER=swift
POSTGRES_PASSWORD=change-this-postgres-password
RABBITMQ_HOST=localhost
RABBITMQ_USER=swift
RABBITMQ_PASSWORD=change-this-rabbitmq-password

# Demo application accounts. Passwords are hashed before they are stored in PostgreSQL.
CLIENT_USERNAME=client-demo
CLIENT_PASSWORD=change-this-client-password
DRIVER_USERNAME=driver-demo
DRIVER_PASSWORD=change-this-driver-password

CMS_USERNAME=swifttrack-cms
CMS_PASSWORD=change-this-cms-password
ROS_API_KEY=change-this-ros-api-key
WMS_AUTH_TOKEN=change-this-wms-token
